<!--
  Tailworm (Tailscale SSH, Oct 2026) detection rules for Wazuh.
  Install: copy into /var/ossec/etc/rules/ on the manager, then restart it.

  Rule IDs 100510-100526 sit in the custom range (php-node-runtime-check uses
  100500-100503). Renumber if they collide with your own rules.

  What feeds each block (see ../agent-snippets.xml and ../../auditd/tailworm.rules):
    100510-100515  hourly `tsctl.sh status` via command monitoring  (posture)
    100516-100518  FIM on tailscaled's environment files            (regression)
    100520-100523  auditd tripwires on root tailscaled               (exploitation)
    100524-100526  kernel OOM kills and systemd restarts             (F5 crash loop)
-->
<group name="tailworm,tailscale,">

  <!-- ===================== Posture: is the mitigation live? ===================== -->

  <rule id="100510" level="0">
    <if_sid>530</if_sid>
    <match>^ossec: output: 'tailworm-posture'</match>
    <description>Tailscale posture check output</description>
  </rule>

  <rule id="100511" level="10">
    <if_sid>100510</if_sid>
    <match>ssh=true forwarding=on</match>
    <description>Tailscale SSH is on with forwarding enabled: Tailworm mitigation missing</description>
    <mitre>
      <id>T1068</id>
    </mitre>
  </rule>

  <rule id="100512" level="8">
    <if_sid>100510</if_sid>
    <match>NOT live until restart</match>
    <description>Tailworm mitigation configured but not live: tailscaled needs a restart</description>
  </rule>

  <rule id="100513" level="5">
    <if_sid>100510</if_sid>
    <match>webclient=true</match>
    <description>Tailscale web client is enabled</description>
  </rule>

  <rule id="100514" level="3">
    <if_sid>100510</if_sid>
    <match>autoupdate=off</match>
    <description>Tailscale auto-update is off</description>
  </rule>

  <rule id="100515" level="5">
    <if_sid>100510</if_sid>
    <match>must run as root|CLI not found|cannot open|No such file|not found</match>
    <description>Tailscale posture check failed to run</description>
  </rule>

  <!-- ===================== Regression: mitigation removed or changed ===================== -->

  <!-- Expected once if you deliberately run `tsctl.sh forwarding=on` on a node. -->
  <rule id="100516" level="12">
    <if_sid>553</if_sid>
    <field name="file">50-tailworm-mitigation.conf$</field>
    <description>Tailworm mitigation drop-in deleted: $(file)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <rule id="100517" level="10">
    <if_sid>550</if_sid>
    <field name="file">tailscaled.service.d/|/etc/default/tailscaled$</field>
    <description>tailscaled environment changed, check TS_SSH_DISABLE_FORWARDING: $(file)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!-- A later drop-in can override ours (systemd applies them in name order). -->
  <rule id="100518" level="7">
    <if_sid>554</if_sid>
    <field name="file">tailscaled.service.d/</field>
    <description>New tailscaled drop-in added: $(file)</description>
  </rule>

  <!-- ===================== Exploitation tripwires (auditd) ===================== -->

  <!-- F2 (BindUnlink): a watched root socket was unlinked, renamed or re-permissioned.
       dockerd and containerd do this themselves on restart, so this parent stays low. -->
  <rule id="100520" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">^tailworm_sock$</field>
    <description>Root-only socket replaced or changed by $(audit.exe)</description>
  </rule>

  <rule id="100521" level="12">
    <if_sid>100520</if_sid>
    <field name="audit.exe">/tailscaled$</field>
    <description>tailscaled replaced a root-only socket: possible Tailworm F2 (ssh -R BindUnlink)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
  </rule>

  <!-- F1/F3/F7: root tailscaled dialed a filesystem unix socket. With forwarding off
       this should never happen, except Serve to a unix: backend you configured. -->
  <rule id="100522" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^tailworm_unix_dial$</field>
    <description>Root tailscaled dialed a unix socket: possible Tailworm F1/F3 forward or F7 Serve to LocalAPI</description>
    <mitre>
      <id>T1068</id>
    </mitre>
  </rule>

  <!-- Known-benign dials: systemd notify, D-Bus (systemd-resolved, NetworkManager),
       abstract sockets. Matches both RAW (hex saddr) and ENRICHED audit logs.
       Add your own Serve unix: backends here (hex = 0100 + hex of the path). -->
  <rule id="100523" level="0">
    <if_sid>100522</if_sid>
    <match>saddr=01002F72756E2F73797374656D642F6E6F74696679|saddr=01002F72756E2F646275732F73797374656D5F6275735F736F636B6574|saddr=01002F7661722F72756E2F646275732F73797374656D5F6275735F736F636B6574|saddr=010000|path=/run/systemd/notify|path=/run/dbus/system_bus_socket|path=/var/run/dbus/system_bus_socket</match>
    <description>Root tailscaled dialed a known system socket (ignored)</description>
  </rule>

  <!-- ===================== F5: tailscaled memory exhaustion / crash loop ===================== -->

  <rule id="100524" level="10">
    <match>(tailscaled) total-vm|task=tailscaled,</match>
    <description>Kernel OOM killer killed tailscaled: possible Tailworm F5 (SSH session memory exhaustion)</description>
    <mitre>
      <id>T1499</id>
    </mitre>
  </rule>

  <rule id="100525" level="5">
    <match>tailscaled.service: Scheduled restart job</match>
    <description>tailscaled crashed and systemd restarted it</description>
  </rule>

  <rule id="100526" level="10" frequency="3" timeframe="600">
    <if_matched_sid>100525</if_matched_sid>
    <description>tailscaled crash loop (3 restarts in 10 minutes): possible Tailworm F5</description>
    <mitre>
      <id>T1499</id>
    </mitre>
  </rule>

</group>
